# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used in email links (required in production)
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Transactional email via Resend (required in production)
RESEND_API_KEY=re_your_api_key

# Orbit Mortgage department senders (configure after domain verification)
EMAIL_FROM_SYSTEM=noreply@orbitmortgage.com
EMAIL_NAME_SYSTEM=Orbit Mortgage System
EMAIL_FROM_LOAN_OFFICER=loanofficer@orbitmortgage.com
EMAIL_NAME_LOAN_OFFICER=Orbit Mortgage Loan Officer
EMAIL_FROM_LENDING=lending@orbitmortgage.com
EMAIL_NAME_LENDING=Chief Lending Officer - Orbit Mortgage
EMAIL_FROM_FUNDING=funding@orbitmortgage.com
EMAIL_NAME_FUNDING=Orbit Mortgage Funding Department
EMAIL_FROM_CLOSINGS=closings@orbitmortgage.com
EMAIL_NAME_CLOSINGS=Orbit Mortgage Closings Department
EMAIL_FROM_SUPPORT=support@orbitmortgage.com
EMAIL_NAME_SUPPORT=Orbit Mortgage Support

# Legacy fallback (optional — used only by older notification helpers)
EMAIL_FROM=Orbit Mortgage <notifications@your-domain.com>

# Protects /api/cron/repayment-reminders (required in production)
CRON_SECRET=generate-a-long-random-secret

# Optional — development email overrides
# RESEND_TEST_TO=you@example.com
# RESEND_DEV_FROM=onboarding@resend.dev
