# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL used in email links (required in production)
NEXT_PUBLIC_APP_URL=https://www.orbittmortgage.com
NEXT_PUBLIC_WEBSITE_DOMAIN=www.orbittmortgage.com

# Transactional email via Resend (required in production)
RESEND_API_KEY=re_your_api_key

# Unified Orbitt Mortgage sender (all outbound email)
EMAIL_FROM=support@orbittmortgage.com
EMAIL_NAME=Orbitt Mortgage
EMAIL_REPLY_TO=support@orbittmortgage.com

# Legacy department keys — optional; all default to support@orbittmortgage.com
EMAIL_FROM_SUPPORT=support@orbittmortgage.com
EMAIL_NAME_SUPPORT=Orbitt Mortgage

# Supabase Auth Send Email Hook (replaces ALL Supabase default auth email templates)
# Dashboard → Authentication → Hooks → Send Email → HTTPS endpoint:
# https://www.orbittmortgage.com/api/auth/hooks/send-email
# Use the full secret from Supabase (format: v1,whsec_<base64>)
SUPABASE_AUTH_HOOK_SECRET="v1,whsec_your_hook_secret"
# Alias also supported:
# SEND_EMAIL_HOOK_SECRET="v1,whsec_your_hook_secret"

# Supabase Auth Custom SMTP via Resend (configure in Supabase Dashboard)
# Host: smtp.resend.com | Port: 465 | Username: resend | Password: RESEND_API_KEY
# Sender: Orbitt Mortgage <support@orbittmortgage.com>
# Enable only if using Supabase-managed auth email delivery instead of the hook.

# Protects /api/cron/repayment-reminders (required in production)
CRON_SECRET=generate-a-long-random-secret

# Optional — admin Telegram alerts (overridden by Super Admin notification settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional — development email overrides
# RESEND_TEST_TO=you@example.com
# RESEND_DEV_FROM=onboarding@resend.dev
